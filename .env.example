# Ace Barber — variables utilisées par la synchronisation des avis Google.
# NE JAMAIS committer de vraies valeurs ici.
# En production, ces valeurs sont stockées dans :
#   GitHub > Settings > Secrets and variables > Actions > "Repository secrets"
#
# Clé API Google (projet Google Cloud, API "Places" activée, restreinte).
GOOGLE_PLACES_API_KEY=
# Identifiant de la fiche Google d'Ace Barber (Place ID).
# À récupérer via le "Place ID Finder" de Google.
GOOGLE_PLACE_ID=
